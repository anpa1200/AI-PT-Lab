# ── Active Provider ──────────────────────────────────────────────────────────
# Uncomment exactly one. Overrides the provider set in scenario YAML.
# CLI flag --provider takes precedence over this.
#LAB_PROVIDER=openai
#LAB_PROVIDER=ollama
#LAB_PROVIDER=anthropic
#LAB_PROVIDER=gemini
#LAB_PROVIDER=vllm

# ── Model Provider API Keys ──────────────────────────────────────────────────
#OPENAI_API_KEY=sk-...
#ANTHROPIC_API_KEY=sk-ant-...
#GOOGLE_API_KEY=AIza...

# ── Local Model Endpoints ────────────────────────────────────────────────────
#OLLAMA_BASE_URL=http://host.docker.internal:11434
#VLLM_BASE_URL=http://host.docker.internal:8080

# ── Lab Runtime ──────────────────────────────────────────────────────────────
LAB_DATA_DIR=./data
LAB_LOG_LEVEL=INFO
LAB_SEED_ON_STARTUP=true
LAB_RESET_ON_STARTUP=false
LAB_MAX_CONCURRENT_SESSIONS=10
